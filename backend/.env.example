# Local development only. Use a long random value and HTTPS in deployed environments.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# The API refuses to start serving requests while this is the placeholder or shorter than 24 characters.
APP_API_KEY=replace-with-a-long-random-secret
DATABASE_PATH=./data/impala_hub.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
# Only for throwaway local experiments with a short key. Never set in a shared environment.
# ALLOW_INSECURE_LOCAL_DEV=true

# Facebook Page publishing. Leave empty to keep publishing switched off (scheduled posts then stay scheduled).
# Not needed when you use "Connect Facebook" in the app (Configuration). Only for the manual single-Page setup.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=


# Required for "Connect Facebook". Create these in Meta for Developers. Never commit the app secret.
META_APP_ID=
META_APP_SECRET=
# Use the Graph API version shown in your Meta app dashboard.
FACEBOOK_API_VERSION=v26.0
PUBLISHER_INTERVAL_SECONDS=30
# Minutes between imports of posts and figures from the Page (0 = off).
FACEBOOK_SYNC_MINUTES=10
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/facebook/callback
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/instagram/callback
FRONTEND_URL=http://localhost:5173
FACEBOOK_FRONTEND_URL=http://127.0.0.1:5173
FACEBOOK_TOKEN_ENCRYPTION_KEY=
META_REDIRECT_URI=http://localhost:8000/api/integrations/facebook/callback
META_GRAPH_API_VERSION=v26.0
META_TOKEN_ENCRYPTION_KEY=
# FACEBOOK_REQUEST_BUSINESS_MANAGEMENT=true

# Sales Desk identity bootstrap. Set these before the first API startup to create the first administrator.
# Use a unique username and a password of at least 14 characters. Once users exist, these values do not reset accounts.
RFQ_BOOTSTRAP_ADMIN_USERNAME=
RFQ_BOOTSTRAP_ADMIN_PASSWORD=
