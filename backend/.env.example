# Local development only. Use HTTPS in deployed environments.
# Generate a strong API key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_API_KEY=replace-with-a-long-random-secret
DATABASE_PATH=./data/impala_hub.db
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
# ALLOW_INSECURE_LOCAL_DEV=true

# Meta app shared by Facebook and Instagram
META_APP_ID=
META_APP_SECRET=
FACEBOOK_API_VERSION=v26.0
# Generate a stable Fernet key:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FACEBOOK_TOKEN_ENCRYPTION_KEY=

# Register both exact URLs in Meta Developer settings:
# Facebook Login > Settings > Valid OAuth Redirect URIs
FACEBOOK_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/facebook/callback
INSTAGRAM_OAUTH_REDIRECT_URI=http://localhost:8000/api/integrations/instagram/callback

# Open the frontend at this exact origin so OAuth sessions persist
FACEBOOK_FRONTEND_URL=http://127.0.0.1:5173

# Optional legacy single-Page fallback. Leave empty when using OAuth.
# After Disconnect, Impala Hub ignores these values until Facebook is reconnected.
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=

PUBLISHER_INTERVAL_SECONDS=30
FACEBOOK_SYNC_MINUTES=10
# FACEBOOK_REQUEST_BUSINESS_MANAGEMENT=true

# Sales Desk first administrator
RFQ_BOOTSTRAP_ADMIN_USERNAME=
RFQ_BOOTSTRAP_ADMIN_PASSWORD=
