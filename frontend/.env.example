# Safe to expose to the browser. These values identify the Supabase project;
# they do not grant privileged database access. Enforce access with RLS policies.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Vercel server-function variables. Keep these private; do not prefix with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-private-service-role-key
FRONTEND_URL=https://your-app.vercel.app
FACEBOOK_OAUTH_REDIRECT_URI=https://your-app.vercel.app/api/marketing/facebook/callback
# Base64-encoded 32-byte AES key; keep the existing value when refactoring.
META_TOKEN_ENCRYPTION_KEY=your-base64-encoded-32-byte-key
CRON_SECRET=your-random-scheduler-secret
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=your-meta-app-secret

# Optional: override the shared Graph API version for every Marketing handler.
# FACEBOOK_API_VERSION=v22.0
