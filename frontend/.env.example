# Safe to expose to the browser. These values identify the Supabase project;
# they do not grant privileged database access. Enforce access with RLS policies.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Existing FastAPI API during the migration period.
VITE_API_URL=http://127.0.0.1:8000

# Vercel server-function variables. Keep these private; do not prefix with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# META_APP_ID=your-meta-app-id
# META_APP_SECRET=your-meta-app-secret
